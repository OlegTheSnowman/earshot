{
  "volume": 0.75,
  "enabled": true,
  "log_events": false,
  "log_spoken": false,
  "speak_final_message": true,
  "speak_max_chars": 0,
  "speak_delay_ms": 1200,
  "speak_tools": true,
  "speak_prompts": true,
  "speak_failures": true,
  "speak_tasks": true,
  "speak_prompt_delay_ms": 900,
  "speak_tool_delay_ms": 350,
  "announce_subagent_tools": false,
  "speak_only_when_focused": true,
  "focus_process_names": ["claude.exe", "code.exe", "windowsterminal.exe"],
  "_comment": "One event name per sound. Where a Claude Code hook supports matchers, each matcher gets its own event name here and its own entry in hooks/hooks.json - that keeps this file a flat map with no matching logic in play.py. A list of several files means one is picked at random, never the same one twice in a row. Remap freely; the only rule is that the filenames exist.",
  "enabled_events": {
    "session-start-startup": true,
    "session-start-resume": true,
    "session-start-clear": true,
    "session-start-compact": true,
    "session-start-fork": true,
    "prompt-submit": true,
    "pre-read": true,
    "pre-edit": true,
    "pre-write": true,
    "pre-bash": true,
    "pre-glob": true,
    "pre-grep": true,
    "pre-webfetch": true,
    "pre-websearch": true,
    "permission-request": true,
    "permission-denied": true,
    "tool-done": true,
    "tool-error": true,
    "tool-batch": true,
    "notification": true,
    "subagent-start": true,
    "subagent-done": true,
    "task-created": true,
    "task-completed": true,
    "stop": true,
    "stop-failure": true,
    "session-end": false,
    "compact": false
  },
  "sounds": {
    "session-start-startup": ["voiceRecordingStarted.mp3"],
    "session-start-resume": ["nextEditSuggestion.mp3"],
    "session-start-clear": ["clear.mp3"],
    "session-start-compact": ["foldedAreas.mp3"],
    "session-start-fork": ["format.mp3"],
    "prompt-submit": ["requestSent.mp3"],
    "pre-read": ["diffLineInserted.mp3"],
    "pre-edit": ["diffLineDeleted.mp3"],
    "pre-write": ["chatEditModifiedFile.mp3"],
    "pre-bash": ["terminalBell.mp3"],
    "pre-glob": ["codeActionTriggered.mp3"],
    "pre-grep": ["codeActionTriggered.mp3"],
    "pre-webfetch": ["progress.mp3"],
    "pre-websearch": ["progress.mp3"],
    "permission-request": ["chatUserActionRequired.mp3"],
    "permission-denied": ["break.mp3"],
    "tool-done": ["terminalCommandSucceeded.mp3"],
    "tool-error": ["warning.mp3"],
    "tool-batch": ["success.mp3"],
    "notification": ["editsUndone.mp3"],
    "subagent-start": ["taskCompleted.mp3"],
    "subagent-done": ["taskFailed.mp3"],
    "task-created": ["quickFixes.mp3"],
    "task-completed": ["diffLineModified.mp3"],
    "stop": ["responseReceived1.mp3"],
    "stop-failure": ["error.mp3"],
    "session-end": ["save.mp3"],
    "compact": ["foldedAreas.mp3"]
  }
}